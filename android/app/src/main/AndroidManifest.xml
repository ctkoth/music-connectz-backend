<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- One permission, and only because Play requires it: digital goods bought
         inside the app must go through Google Play Billing, not Stripe. The TWA
         reaches it through the Digital Goods API, and the backend verifies every
         purchase token at /api/economy/play/verify/ before granting anything.
         See GOOGLE_PLAY.md §9.

         BILLING is not a privacy-relevant permission, so the Data safety form
         stays short: no networking permission (Chrome does that), no storage, no
         location. -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MusicConnectZ">

        <!-- Proves to Chrome that this app owns the site. Must match what
             https://musicconnectz.net/.well-known/assetlinks.json says back,
             or the app shows a URL bar. -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MusicConnectZ.Splash">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="${siteUrl}" />

            <!-- Native splash while Chrome warms up, so a cold start doesn't
                 flash white. The image is the wordless mark. -->
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@drawable/splash" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/brand_ink" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION"
                android:value="300" />
            <meta-data
                android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITIES"
                android:value="${applicationId}.fileprovider" />

            <!-- Lets the web app call the Digital Goods API / Payment Request
                 with the "https://play.google.com/billing" payment method. -->
            <meta-data
                android:name="android.support.customtabs.trusted.ENABLE_PLAY_BILLING"
                android:value="true" />

            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/brand_ink" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/brand_ink" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Links to the site open in the app instead of the browser.
                 autoVerify makes Android check assetlinks.json at install. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="${siteHost}"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- Lets Chrome hand notifications and cookies back to the app. -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Hands the splash bitmap to Chrome so the transition is seamless. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
    </application>
</manifest>
