<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ owns the splash screen. Hand it the wordless mark and the brand
  ink; the system animates it and hands off to Chrome.
-->
<resources>
    <style name="Theme.MusicConnectZ.Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/brand_ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:statusBarColor">@color/brand_ink</item>
        <item name="android:navigationBarColor">@color/brand_ink</item>
    </style>
</resources>
