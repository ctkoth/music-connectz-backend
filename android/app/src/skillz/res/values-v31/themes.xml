<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ owns the splash screen. Same as main's, with the SkillZ icon in place
  of the Music ConnectZ mark: the system masks it to a circle, which is what
  ic_skillz_foreground is drawn for (the name clears a 66dp circle).
-->
<resources>
    <style name="Theme.MusicConnectZ.Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/brand_ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_skillz_foreground</item>
        <item name="android:statusBarColor">@color/brand_ink</item>
        <item name="android:navigationBarColor">@color/brand_ink</item>
    </style>
</resources>
